PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Customer menu/order access is allowed only when the request originates from
# this public IP (normally the cafe router's WAN IP). On Render, set this in
# the service Environment settings rather than committing it to source control.
CAFE_PUBLIC_IP=YOUR_CAFE_PUBLIC_IP
# Set true for local development only; leave false/unset in production.
ALLOW_LOCALHOST_MENU_ACCESS=true
# Render forwards requests through a trusted internal proxy chain. Keep false
# locally unless you use a trusted local reverse proxy.
TRUST_PROXY=false

# Brevo SMTP config for password resets
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key
SENDER_EMAIL=your_sender_email
